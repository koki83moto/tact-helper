{
  "manifest_version": 3,
  "name": "TACT Helper",
  "version": "1.0.0",
  "description": "TACTの課題締切をGoogleカレンダーへ自動同期し、授業資料を階層ごと差分ダウンロードします。",
  "permissions": ["identity", "storage", "alarms"],
  "host_permissions": [
    "https://tact.ac.thers.ac.jp/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TACT Helper を開く"
  },
  "options_page": "manager.html",
  "content_scripts": [
    {
      "matches": ["https://tact.ac.thers.ac.jp/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar"]
  }
}
